{
  "scripts": {
    "cov": "c8 report --reporter=text-lcov",
    "cov-html": "c8 report --reporter=html",
    "build": "rollup -c",
    "prepublishOnly": "npm test",
    "start": "npm run watch & npm run server",
    "watch": "rollup -c -w 'src/**'",
    "server": "browser-sync start --files 'dist/*, style.css, index.html' --server",
    "test": "c8 mocha --require test-setup.js src/**/*.spec.js"
  },
  "type": "module",
  "devDependencies": {
    "@riotjs/compiler": "^10.0.0",
    "@riotjs/register": "^10.0.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "browser-sync": "^3.0.4",
    "c8": "^10.1.3",
    "chai": "^6.0.1",
    "jsdom": "^26.1.0",
    "jsdom-global": "^3.0.2",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "rollup": "^4.47.1",
    "rollup-plugin-riot": "^10.0.0"
  },
  "dependencies": {
    "riot": "^10.0.0"
  }
}
